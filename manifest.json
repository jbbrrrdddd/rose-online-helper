{
  "manifest_version": 3,
  "name": "Game Auto Helper",
  "version": "3.1.0",
  "description": "Per-tab game helper with automatic stop when the character changes maps/zones.",
  "permissions": [
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Game Auto Helper"
  }
}